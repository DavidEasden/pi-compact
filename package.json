{
  "name": "pi-compact",
  "version": "0.3.0",
  "description": "不依赖 LLM 的 Pi 自动压缩、精确历史召回与上下文增强扩展",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "index.ts",
    "src"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.integration.mjs",
    "test:integration": "node --test tests/*.integration.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^22.19.19",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}
